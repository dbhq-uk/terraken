---
// A header, not a navigation system. Seven pages, so the six that are not the
// index sit in a row beside the wordmark, and it is still a row: no dropdown,
// no burger and no focus management to get wrong. It wraps to a second line
// under 620px, which is what the labels were kept short for. dbhq.uk carries a
// six-row Explore panel because it has six families to carry; this site has one
// tool and a set of guides about the problem it is for.
//
// The lockup is the link home to dbhq.uk and the wordmark beside it names this
// site, exactly as on skills.dbhq.uk. That split is deliberate: the brand
// belongs to the practice, and this hostname is one of its properties.
import Mark from "./Mark.astro";
import { nav, REPO } from "../lib/site";

const path = Astro.url.pathname;
const onIndex = path === "/" || path === "";
---

<header class="hd">
  <div class="container hd-inner">
    <a class="hd-logo" href="https://dbhq.uk/" aria-label="DBHQ - the practice that publishes terraken">
      <img src="/logo/dbhq-lockup-horizontal-white.svg" alt="DBHQ" width="184" height="46" />
    </a>
    <span class="hd-sep" aria-hidden="true"></span>
    {onIndex ? (
      <span class="hd-site" aria-current="page"><Mark size={26} tone="reverse" />terraken</span>
    ) : (
      <a class="hd-site" href="/"><Mark size={26} tone="reverse" />terraken</a>
    )}
    <nav class="hd-nav" aria-label="Sections">
      {nav.map((n) => (
        <a
          class="hd-link"
          href={n.path}
          aria-current={path === n.path ? "page" : undefined}
        >{n.label}</a>
      ))}
      <a class="hd-gh" href={REPO} aria-label="terraken source on GitHub">
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  /* SOLID INK, NOT A BLURRED PANE. The masthead is the first thing a visitor
     sees and it is the brand's own ground, so it is opaque: a translucent bar
     with a blur behind it is glass, and this brand is an instrument. Opaque
     also means the edge against the paper below is a hard one at every scroll
     position rather than a soft one that changes with what is under it.

     The hairline is --ink-line, which is all but invisible where the masthead
     sits directly over an ink hero and lets the two read as one field. Against
     paper the ink block is its own edge and needs no help. */
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    border-bottom: 1px solid var(--ink-line);
  }
  .hd-inner { display: flex; align-items: center; gap: 12px; min-height: 68px; flex-wrap: wrap; padding-block: 8px; }
  /* The reversed lockup: the DBHQ wordmark in white, the mark's blue and teal
     untouched. It is brand/logo/dbhq-lockup-horizontal-white.svg, the same file
     dbhq.uk carries, not an inverted copy of the ink one - inverting would take
     the blue to orange. */
  .hd-logo img { height: 34px; width: auto; }
  /* A hairline, not a slash: the two marks are separate identities sharing a
     row, and a punctuation glyph would be read aloud. */
  .hd-sep { width: 1px; height: 20px; background: var(--ink-line); }
  .hd-site {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--surface);
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  a.hd-site:hover { color: var(--ink-text); }

  .hd-nav { margin-left: auto; display: flex; flex-wrap: wrap; gap: 6px 20px; }
  /* The quiet step on ink, which is --ink-text mixed back towards the ground.
     --text-3, which this row used on paper, measures 3.56:1 here and fails. */
  .hd-link { color: color-mix(in srgb, var(--ink-text) 72%, var(--ink)); font-size: 0.88rem; font-weight: 500; }
  .hd-link:hover { color: var(--surface); }
  .hd-link[aria-current="page"] { color: var(--surface); }

  /* GitHub closes the row. It is a link to the source, which for a tool whose
     whole claim is that you can check what it does is a first-class
     destination rather than a footer courtesy. Inline SVG, not an image from
     githubassets: _headers sends a CSP with no third-party origin at all, and
     opening one for a 900-byte glyph would be a poor trade. */
  .hd-gh {
    display: inline-flex;
    align-items: center;
    color: color-mix(in srgb, var(--ink-text) 72%, var(--ink));
    transition: color .12s linear;
    margin-left: 4px;
  }
  .hd-gh:hover { color: var(--surface); }

  @media (max-width: 620px) {
    .hd-nav { margin-left: 0; width: 100%; gap: 6px 16px; }
  }
</style>
