---
// A header, not a navigation system. Seven pages, so the six that are not the
// index sit in a row beside the wordmark, and it is still a row: no dropdown,
// no burger and no focus management to get wrong. It wraps to a second line
// under 620px, which is what the labels were kept short for. dbhq.uk carries a
// six-row Explore panel because it has six families to carry; this site has one
// tool and a set of guides about the problem it is for.
//
// THE DBHQ LOCKUP IS NOT IN THIS MASTHEAD (Dan, 16 Sep 2026). It used to open
// the bar, with a divider, and the Terraken wordmark second - the pattern
// skills.dbhq.uk uses. Two marks and two wordmarks in the top left is a lot of
// identity before a reader has learned the one that matters, and on a product
// site the product should be the thing in the corner.
//
// The endorsement is not lost, it has moved to where it belongs: the footer
// carries the full DBHQ lockup and the "Also from DBHQ" block, which is where
// somebody asks who made this. Do not put it back up here without asking.
import Mark from "./Mark.astro";
import { nav, REPO } from "../lib/site";

const path = Astro.url.pathname;
const onIndex = path === "/" || path === "";
---

<header class="hd">
  <div class="container hd-inner">
    {onIndex ? (
      <span class="hd-site" aria-current="page"><Mark size={26} tone="reverse" />terraken</span>
    ) : (
      <a class="hd-site" href="/"><Mark size={26} tone="reverse" />terraken</a>
    )}
    <nav class="hd-nav" aria-label="Sections">
      {nav.map((n) => (
        <a
          class="hd-link"
          href={n.path}
          aria-current={path === n.path ? "page" : undefined}
        >{n.label}</a>
      ))}
    </nav>
    {/* THE THIRD ZONE, out of the nav it used to sit inside. As the last child
        of a six-link row it read as a seventh nav item that had lost its
        label; on its own at the right edge it reads as what it is, the way
        out to the source. */}
    <a class="hd-gh" href={REPO} aria-label="Terraken source on GitHub">
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
      </svg>
    </a>
  </div>
</header>

<style>
  /* SOLID INK, NOT A BLURRED PANE. The masthead is the first thing a visitor
     sees and it is the brand's own ground, so it is opaque: a translucent bar
     with a blur behind it is glass, and this brand is an instrument. Opaque
     also means the edge against the paper below is a hard one at every scroll
     position rather than a soft one that changes with what is under it.

     The hairline is --ink-line, which is all but invisible where the masthead
     sits directly over an ink hero and lets the two read as one field. Against
     paper the ink block is its own edge and needs no help. */
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    border-bottom: 1px solid var(--ink-line);
  }
  /* THREE ZONES, NOT TWO. The nav used to be pushed to the right edge with
     margin-left: auto, which left a wide empty band across the middle of the
     bar and six same-weight links jammed into the corner. A centre column is
     what every well-made developer site does here - Zed and Bun both put the
     lockup left, the nav in the middle and the actions right - and it works
     because the void was never wasted space, it was an unassigned zone.

     Named columns rather than three divs with auto margins: the centre stays
     centred on the BAR, not on whatever is left after the lockup, so the row
     does not shift when the wordmark changes length. */
  .hd-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    min-height: 64px;
    padding-block: 8px;
  }
  /* .hd-logo and .hd-sep are gone with the DBHQ lockup they styled. The
     reversed lockup file itself is still shipped and still used - the footer
     carries it - so public/logo/ is not dead weight. */
  .hd-site {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--surface);
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  a.hd-site:hover { color: var(--ink-text); }

  /* The centre zone. justify-content: center rather than the old right-align,
     and a wider gap: at 20px six labels of very different lengths read as one
     run-on string, and the row is a list of six destinations. */
  .hd-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px clamp(18px, 2.2vw, 30px); }
  /* The quiet step on ink, which is --ink-text mixed back towards the ground.
     --text-3, which this row used on paper, measures 3.56:1 here and fails. */
  .hd-link { color: color-mix(in srgb, var(--ink-text) 72%, var(--ink)); font-size: 0.9rem; font-weight: 500; white-space: nowrap; }
  .hd-link:hover { color: var(--surface); }
  /* The current page is stated twice - brighter, and underlined - because on
     a row of six quiet labels a colour step alone is easy to miss. */
  .hd-link[aria-current="page"] {
    color: var(--surface);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--surface) 40%, transparent);
  }

  /* GitHub closes the row. It is a link to the source, which for a tool whose
     whole claim is that you can check what it does is a first-class
     destination rather than a footer courtesy. Inline SVG, not an image from
     githubassets: _headers sends a CSP with no third-party origin at all, and
     opening one for a 900-byte glyph would be a poor trade. */
  .hd-gh {
    display: inline-flex;
    align-items: center;
    color: color-mix(in srgb, var(--ink-text) 72%, var(--ink));
    transition: color .12s linear;
    margin-left: 4px;
  }
  .hd-gh:hover { color: var(--surface); }

  /* Below 900px there is no room for three zones, so it becomes two rows: the
     lockup and GitHub on the first, the nav wrapping underneath. The nav goes
     left-aligned there rather than centred - a wrapped centred row leaves a
     ragged last line that reads as a mistake. */
  @media (max-width: 900px) {
    .hd-inner {
      grid-template-columns: auto auto;
      justify-content: space-between;
      row-gap: 10px;
      padding-block: 10px;
    }
    .hd-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      gap: 6px 18px;
    }
    .hd-gh { grid-column: 2; grid-row: 1; }
  }
</style>
