---
/* The questions at the foot of a guide page.
 *
 * ONE DEFINITION, TWO SURFACES. The same array in src/lib/site.ts renders here
 * and is published as FAQPage structured data by src/lib/schema.ts. That is
 * deliberate: an answer written for an engine and not for a reader is a page
 * nobody should rank, and two copies of an answer is how one of them goes
 * stale.
 *
 * Plain headings rather than <details>. An answer hidden behind a disclosure is
 * one a reader has to guess is worth opening, and these are short enough to
 * read straight through.
 */
import type { Faq } from "../lib/site";

interface Props {
  faqs: readonly Faq[];
  heading?: string;
}
const { faqs, heading = "Questions" } = Astro.props;
---

<div class="faqs">
  <h2 class="block-h">{heading}</h2>
  <dl class="faq-list">
    {faqs.map((f) => (
      <div class="faq">
        <dt class="faq-q">{f.q}</dt>
        <dd class="faq-a">{f.a}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .faqs { max-width: 820px; }
  .faq-list { margin: 0; display: grid; gap: 0; }
  .faq { padding-block: clamp(16px, 2vw, 20px); border-top: 1px solid var(--border); }
  .faq:first-child { border-top: 0; padding-top: 0; }
  /* A question sets at 16 to 18px, which is under the size where tracking earns
     anything, so it carries none. */
  .faq-q {
    color: var(--text);
    font-size: clamp(1.18rem, 1.5vw, 1.3rem);
    font-weight: 600;
    line-height: 1.3;
  }
  /* The answers are read the way the article above them is, so they set at the
     article's size and hold the article's measure. */
  .faq-a { margin: 8px 0 0; color: var(--text-2); font-size: 1.125rem; line-height: 1.65; max-width: 68ch; }
</style>
