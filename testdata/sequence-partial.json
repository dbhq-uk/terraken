{
  "format_version": "1.2",
  "terraform_version": "1.16.1",
  "_comment": "HAND-WRITTEN, unlike the other sequence fixtures. A no-op dependant of a replaced resource cannot be generated from terraform_data: every one of its attributes is unknown after a replacement, so anything reading one is always planned as a change. It is realistic on a real provider - a resource reading a subnet's name, where the name is known and unchanged across the replacement - and this is the shape of that plan. terraform_data and the local provider only, as AGENTS.md requires.",
  "resource_changes": [
    {
      "address": "terraform_data.base",
      "mode": "managed",
      "type": "terraform_data",
      "name": "base",
      "provider_name": "terraform.io/builtin/terraform",
      "change": {
        "actions": ["delete", "create"],
        "before": {"id": "base-1", "input": "v1"},
        "after": {"input": "v2"},
        "after_unknown": {"id": true, "output": true},
        "before_sensitive": {},
        "after_sensitive": {},
        "replace_paths": [["triggers_replace"]]
      },
      "action_reason": "replace_because_cannot_update"
    },
    {
      "address": "terraform_data.rebuilt",
      "mode": "managed",
      "type": "terraform_data",
      "name": "rebuilt",
      "provider_name": "terraform.io/builtin/terraform",
      "change": {
        "actions": ["delete", "create"],
        "before": {"id": "rebuilt-1", "input": "rebuilt"},
        "after": {"input": "rebuilt"},
        "after_unknown": {"id": true, "output": true},
        "before_sensitive": {},
        "after_sensitive": {}
      }
    },
    {
      "address": "terraform_data.dormant",
      "mode": "managed",
      "type": "terraform_data",
      "name": "dormant",
      "provider_name": "terraform.io/builtin/terraform",
      "change": {
        "actions": ["no-op"],
        "before": {"id": "dormant-1", "input": "base"},
        "after": {"id": "dormant-1", "input": "base"},
        "after_unknown": {},
        "before_sensitive": {},
        "after_sensitive": {}
      }
    }
  ],
  "configuration": {
    "root_module": {
      "resources": [
        {
          "address": "terraform_data.base",
          "mode": "managed",
          "type": "terraform_data",
          "name": "base",
          "provider_config_key": "terraform",
          "expressions": {"input": {"references": ["var.release"]}}
        },
        {
          "address": "terraform_data.rebuilt",
          "mode": "managed",
          "type": "terraform_data",
          "name": "rebuilt",
          "provider_config_key": "terraform",
          "expressions": {
            "triggers_replace": {"references": ["terraform_data.base.output", "terraform_data.base"]}
          }
        },
        {
          "address": "terraform_data.dormant",
          "mode": "managed",
          "type": "terraform_data",
          "name": "dormant",
          "provider_config_key": "terraform",
          "expressions": {
            "input": {"references": ["terraform_data.base.input", "terraform_data.base"]}
          }
        }
      ]
    }
  }
